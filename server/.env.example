PORT=8000
MONGODB_URI=mongodb+srv://user:password@cluster/database
MOBILE_API_SECRET=change-me
WFT_URL=https://example.com/word-for-today
ADMIN_JWT_SECRET=
# Optional: User-Agent sent to OpenStreetMap services (Overpass, Nominatim)
OSM_USER_AGENT=
# Optional: comma-separated Overpass API interpreter URLs, tried in order
OVERPASS_URLS=
# Optional: S3 storage for post images. Uploads stay off until S3_BUCKET and AWS_REGION are set.
# The bucket can stay private ("Block all public access" on) because the API issues signed URLs.
# The credentials only need s3:PutObject, s3:GetObject and s3:DeleteObject on
# arn:aws:s3:::<bucket>/churches/*
S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
